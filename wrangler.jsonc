/**
 * Muse Proxy — an API-key gateway for user:password services and inbound mail.
 *
 * Routing contract (see src/index.ts):
 *   /                        Worker-rendered landing page
 *   /api/agent/<service>/*   provider-owned agent API (Bearer key, any HTTP method)
 *   /api, /api/*                   admin + agent JSON API (Hono)
 *   /docs/*, /llms.txt       static assets
 *   /user/*                  React SPA; unmatched paths fall back to the SPA shell
 *
 * `not_found_handling: "single-page-application"` always rewrites an unmatched
 * request to the ROOT /index.html, which is why the SPA shell is built to
 * dist/index.html with its bundle under dist/user/assets (Vite `assetsDir`), and
 * the landing page is rendered by the Worker at "/" instead of living in the
 * assets directory.
 *
 * The one required secret, CREDENTIAL_ENCRYPTION_KEY, is intentionally not
 * listed here: see .dev.vars.example.
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "muse-proxy",
	"main": "src/index.ts",
	"compatibility_date": "2026-03-10",
	"observability": {
		"enabled": true
	},
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": "./frontend/dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/",
			"/api",
			"/api/*"
		]
	},
	/**
	 * D1 holds accounts, encrypted service credentials, scoping rules and API keys.
	 * Create it with `wrangler d1 create muse-proxy`, then paste the id below.
	 */
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "muse-proxy",
			/**
			 * A placeholder, deliberately. The Deploy to Cloudflare button needs a
			 * value here to recognise the binding at all; it provisions the database
			 * and writes the real id into the repository it creates for you.
			 *
			 * Deploying by hand, replace it with the id printed by
			 * `npx wrangler d1 create muse-proxy`.
			 */
			"database_id": "9ce05405-1437-4abc-98a3-fadc15e90cb2"
		}
	],
	/**
	 * Mail attachments above INLINE_ATTACHMENT_MAX live here. The id is the
	 * existing Maildrop namespace, deliberately reused: migrated attachment rows
	 * keep their att/<mailbox>/<message>/<attachment> keys, and those objects are
	 * still addressable after the merge.
	 */
	"kv_namespaces": [
		{
			"binding": "ATTACHMENTS",
			"id": "9daae8e2c54b4e4f8b94e0f65ac0d438"
		}
	],
	"vars": {
		/** Allow self-service account creation from the frontend. The first account can always be created. */
		"SIGNUP_ENABLED": "false",
		/**
		 * PBKDF2 iterations for account passwords. 100_000 keeps login inside the
		 * Free plan's 10ms CPU budget; raise it on a Paid plan.
		 * Stored inside each hash, so raising it never invalidates existing accounts.
		 */
		"PBKDF2_ITERATIONS": "100000",
		"SESSION_TTL_DAYS": "30",
		/** Allow upstream servers on private/LAN addresses (e.g. a self-hosted Radicale). */
		"ALLOW_PRIVATE_NETWORKS": "false",
		/** Allow plain http:// upstream servers. Off by default: credentials would travel in the clear. */
		"ALLOW_INSECURE_HTTP": "false",
		/** Optional comma-separated origins allowed to call /api/agent from a browser. Empty disables CORS entirely. */
		"AGENT_CORS_ORIGIN": "",
		/**
		 * Mail, merged from Maildrop. Addresses may still be on the Maildrop domain
		 * even though the HTTP hostname is retired: Cloudflare Email Routing targets
		 * the Worker, not a custom HTTP route.
		 */
		"DEFAULT_DOMAIN": "maildrop.beautiful.computer",
		/** Largest inbound message accepted, in bytes. Cloudflare caps inbound mail at 25 MiB. */
		"MAX_MESSAGE_BYTES": "10485760",
		/** Attachments at or below this size are stored as D1 BLOBs; larger ones go to KV. */
		"INLINE_ATTACHMENT_MAX": "1048576",
		/** Raw RFC 822 source is kept inline only when it fits in this many bytes. */
		"RAW_INLINE_MAX": "131072",
		/** Text and HTML bodies are truncated to this many bytes each. */
		"MAX_BODY_BYTES": "524288",
		/** Stored for future use. 0 disables; trim and purge are the active controls. */
		"RETENTION_DAYS": "0"
	},
	"keep_vars": true,
	"secrets": {
		"required": [
			"CREDENTIAL_ENCRYPTION_KEY"
		]
	},
	"routes": [
		{
			"pattern": "muse.beautiful.computer",
			"zone_name": "beautiful.computer",
			"custom_domain": true,
			"enabled": true,
			"previews_enabled": false
		}
	]
}